class Solution(object):
    def strStr(self, haystack, needle):
        m=len(haystack)
        n=len(needle)
        if m<n:
            return -1
        for i in range(m-n+1):
            for j in range(n):
                if haystack[i+j]!=needle[j]:
                    break
            else:
                return i
                    
        else:
            return -1
