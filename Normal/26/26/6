Input: s = "PAYPALISHIRING", numRows = 3
Output: "PAHNAPLSIIGYIR"

if numRows == 1:
            return s

        rows = [""] * numRows

        current = 0
        direction = 1

        for char in s:
            rows[current] += char

            if current == 0:
                direction = 1
            elif current == numRows - 1:
                direction = -1

            current += direction

        return "".join(rows)