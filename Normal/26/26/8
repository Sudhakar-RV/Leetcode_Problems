x = 121
Output: true
Explanation: 121 reads as 121 from left to right and from right to left.

class Solution(object):
    def isPalindrome(self, x):
        orginal = x
        rev=0
        while x>0:
            digit=x%10
            rev=rev*10+digit
            x//=10
        if orginal == rev:
            return True
        else:
            return False