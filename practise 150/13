class Solution(object):
    def canCompleteCircuit(self, gas, cost):
        total=0
        start=0
        tank=0
        for i in range(len(gas)):
            tank=tank+gas[i]-cost[i]
            total=total+gas[i]-cost[i]
            if tank<0:
                tank=0
                start=i+1
        if total<0:
            return -1
        return start