Input: nums = [1,1,1,2,2,3]
Output: 5, nums = [1,1,2,2,3,_]

class Solution(object):
    def removeDuplicates(self, nums):
        k=0
        a=[]
        for i in nums:
            if i not in a:
                a.append(i)
                k+=1
        nums[:k] = a
        return (k)
        return (nums)